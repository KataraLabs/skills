{
  "notes": "How a client treats each skill. kind is language, framework or workflow. Language and framework skills are attached from project signals; detect lists those signals (any one matching is enough). Workflow skills carry default on or off. servable says whether the skill's license lets a hosted service send its text to users; it is false for skills we do not hold the right to redistribute. Skills under skills/katara/ take their detect hints from their own front matter. A skill is attached when any one of its detect signals matches and, if it has requires, every list in requires also has a match. Framework skills never rely on a generic manifest (generic_project_files) as a signal: those name the ecosystem, not the framework.",
  "detect_keys": {
    "file_types": "glob patterns for source files",
    "project_files": "paths or globs relative to the project root; a trailing slash means a directory",
    "package_dependencies": "npm package names in package.json dependencies or devDependencies",
    "dependencies": "ecosystem:name for other package managers: pypi, gem, composer, maven (group:artifact), nuget, pub, npm",
    "requires": "an object with the same keys; each list in it must also have a match"
  },
  "folders": {
    "skills/katara": {
      "kind": "language"
    },
    "skills/addyosmani": {
      "kind": "workflow"
    },
    "skills/callstack": {
      "kind": "workflow"
    },
    "skills/lambdatest": {
      "kind": "workflow"
    },
    "skills/trailofbits": {
      "kind": "workflow"
    }
  },
  "default_on": [
    "debugging-and-error-recovery",
    "test-driven-development",
    "planning-and-task-breakdown",
    "code-review-and-quality"
  ],
  "not_servable_licenses": [
    null,
    "UNLICENSED"
  ],
